# Copia este archivo como .env y ajusta los valores.
# El archivo .env nunca se sube a GitHub (está en .gitignore).

# Conexión a la base de datos de desarrollo (la de docker-compose.yml)
DATABASE_URL=postgresql+psycopg://auto:auto@localhost:5433/auto_ibaguer

# Base de datos que crean y borran las pruebas automáticas
TEST_DATABASE_URL=postgresql+psycopg://auto:auto@localhost:5433/auto_ibaguer_pruebas

# Zona horaria del negocio: define el día de cada turno y el cierre de caja
ZONA_HORARIA=America/Bogota

# desarrollo o produccion
ENTORNO=desarrollo

# Firma la sesión del dashboard. En tu computador no hace falta: déjala comentada.
# En producción es obligatoria y secreta; se genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CLAVE_SECRETA=

# Horas sin usar el dashboard para que pida la contraseña otra vez
SESION_HORAS=12
