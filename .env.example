# Copia este archivo como .env y ajusta los valores.
# El archivo .env nunca se sube a GitHub (está en .gitignore).

# Conexión a la base de datos de desarrollo (la de docker-compose.yml)
DATABASE_URL=postgresql+psycopg://auto:auto@localhost:5433/auto_ibaguer

# Base de datos que crean y borran las pruebas automáticas
TEST_DATABASE_URL=postgresql+psycopg://auto:auto@localhost:5433/auto_ibaguer_pruebas

# Zona horaria del negocio: define el día de cada turno y el cierre de caja
ZONA_HORARIA=America/Bogota

# desarrollo o produccion
ENTORNO=desarrollo

# Firma la sesión del dashboard. En tu computador no hace falta: déjala comentada.
# En producción es obligatoria y secreta; se genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CLAVE_SECRETA=

# Horas sin usar el dashboard para que pida la contraseña otra vez
SESION_HORAS=12

# El reloj que cada 30 segundos pasa al final a quien no llegó a tiempo, entre otras cosas.
# En la nube va siempre en true. En tu computador puedes ponerlo en false para mirar algo
# sin que el reloj mueva la fila.
RELOJ_ACTIVO=true

# --- WhatsApp (Cloud API de Meta). Déjalos vacíos hasta registrar el número del bot.
# Son secretos: escríbelos solo en tu .env. Nunca en GitHub, ni en un chat, ni en capturas.
# Token permanente del usuario del sistema (Configuración del negocio > Usuarios del sistema)
WHATSAPP_TOKEN=
# "Identificador del número de teléfono" (WhatsApp > Configuración de la API)
WHATSAPP_ID_NUMERO=
# "Identificador de la cuenta de WhatsApp Business" (WhatsApp > Configuración de la API,
# encima del número). Lo usa registrar-whatsapp para enlazar la app con la cuenta.
WHATSAPP_ID_CUENTA=
# Clave secreta de la app (Configuración de la app > Básica > Clave secreta)
WHATSAPP_SECRETO_APP=
# Una palabra que inventas y escribes también en Meta al registrar el webhook
WHATSAPP_TOKEN_VERIFICACION=
WHATSAPP_VERSION_API=v26.0

# --- Gemini (Google AI Studio). Entiende lo que el cliente escribe con sus palabras
# ("cuánto vale lavar la camionetica"). Sin la clave, el bot funciona con botones.
# La clave es secreta: escríbela solo en tu .env.
GEMINI_CLAVE=
# true solo si el proyecto de Google tiene facturación activa (plan de pago). En el
# plan gratis Google usa los mensajes para mejorar sus productos y personas los pueden
# leer: sirve para probar con mensajes tuyos, pero en la nube (ENTORNO=produccion) el
# bot no usa Gemini mientras esto no esté en true.
GEMINI_PLAN_DE_PAGO=false

# --- Correo del reporte diario del parqueadero (al cerrar la caja les llega a los jefes).
# Con Gmail: CORREO_SERVIDOR=smtp.gmail.com, CORREO_PUERTO=465, CORREO_USUARIO=el correo
# y CORREO_CLAVE=una "contraseña de aplicación" de 16 letras (no la contraseña normal; cómo
# sacarla, en el README). La clave es secreta: escríbela solo en tu .env. Vacíos: no se
# manda correo (el reporte igual se puede mandar por WhatsApp desde Balance).
# Ojo: el plan gratis de Render bloquea el correo; en el plan de pago sí sale.
CORREO_SERVIDOR=
CORREO_PUERTO=465
CORREO_USUARIO=
CORREO_CLAVE=
# Opcional: la dirección que sale como remitente, si no es la misma del usuario.
CORREO_REMITENTE=
